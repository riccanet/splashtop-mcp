# Splashtop Web API token: web console > Account Settings > Web API Tokens (team owners and super admins only).
# Give it the scopes you need (users, logs, team_users, team_computers, team_groups, inventory, ...);
# a read-only token is enough unless you enable writes.
SPLASHTOP_API_TOKEN=

# API host: us (default, https://webapi.splashtop.com), eu (https://webapi.splashtop.eu), or a full URL.
#SPLASHTOP_API_URL=us

# Team id (stb_team_id). Detected automatically from /users/basic_info when empty.
#SPLASHTOP_TEAM_ID=

# Shared secret clients must send as "Authorization: Bearer <token>" (generate: openssl rand -hex 32)
MCP_AUTH_TOKEN=

# Allow modifying API requests (rename/delete computers, add notes, change users/groups) with two-step confirm.
# Default false = read-only.
SPLASHTOP_ENABLE_WRITES=false
